// 淘宝双 11「做任务赚能量」流水线。
//
// 坐标一律是识别图像坐标：控制器把截图缩放到短边 720，所以竖屏手机固定是 720 宽。
// 换机型不用改 roi，只有宽高比差异会挪动读秒气泡，因此气泡只认文字不认位置。
//
// roi / target 的四元组是 [x, y, width, height]，不是左上右下：x/y 为负从右下边缘算，
// 宽或高为 0 表示延伸到那一侧边缘。写成左上右下不会报错，只会被静默裁切，
// 于是识别范围比预想的大一截 —— 日志里会有一堆 "roi is out of range" 警告。
//
// 一条排布规矩：候选链里 DirectHit 节点必须排在所有带识别的节点后面。
// next 按顺序取第一个命中的，DirectHit 永远命中，排在中间等于把后面的节点全废掉。
//
// 还有一条：post_wait_freezes 默认盯的是「识别框」，而 DirectHit 节点没有识别框，
// 所以光写 "post_wait_freezes": 500 等于没等，还会每次打一条 failed to get target rect
// 的 ERR（实测一段刷了 33 条）。要等就得显式给它 target 矩形，见下面三个退出节点。
{
    "Default": {
        "rate_limit": 1000
    },

    // 入口分诊：面板 → 活动页入口 → 跨应用返回 → 右上角关闭 → 退出梯子。
    // 退出梯子三段全是 DirectHit，靠 max_hit 依次耗尽来降级：
    // 先盲点左上角返回箭头，再试边缘手势，最后才重开应用。
    // 顺序不能反：LaunchTaobao 排在前面的时候，实测它在 50 秒里空转了 5 次 ——
    // 淘宝还开着一个 H5 子页时 start_app 只是把应用重新聚焦，画面一动不动，
    // 而它后面的 EdgeBack 因为是第二个 DirectHit 永远轮不到。
    "EarnEnergy": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "timeout": 15000,
        "next": ["NeedHuman", "Blocked", "DangerPage", "DismissDialog", "LeaveDialog", "TaskPanel", "NoInstall", "OpenTaskPanel", "BackToTaobao", "CloseX", "CloseCircle", "GoMine", "CornerBack", "EdgeBack", "LaunchTaobao"],
        "on_error": ["GiveUp"]
    },

    "OpenTaskPanel": {
        "recognition": "OCR",
        "expected": ["去赚能量"],
        "action": "Click",
        "post_wait_freezes": 500,
        "timeout": 8000,
        "next": ["TaskPanel"],
        "on_error": ["EarnEnergy", "GiveUp"]
    },

    // 面板是三态分诊台：先领累计奖励，再判断有没有浏览任务，最后才点任务。
    "TaskPanel": {
        "recognition": "OCR",
        "expected": ["做任务赚能量"],
        "action": "DoNothing",
        "pre_wait_freezes": 300,
        "timeout": 15000,
        "next": ["ClaimReward", "TaskRow", "PanelDrained"],
        "on_error": ["EarnEnergy", "GiveUp"]
    },

    "ClaimReward": {
        "recognition": "OCR",
        "expected": ["立即领取"],
        "action": "Click",
        "post_wait_freezes": 500,
        "max_hit": 8,
        "timeout": 5000,
        "next": ["TaskPanel"],
        "on_error": ["TaskPanel", "GiveUp"]
    },

    // 面板上再也找不到「浏览N秒」的副标题，说明能自动做的浏览任务清空了。
    // next 为空即任务正常结束。
    "PanelDrained": {
        "recognition": "OCR",
        "expected": ["浏览\\d+", "点击去逛"],
        "inverse": true,
        "action": "Swipe",
        "begin": [360, 1250],
        "end": [360, 900],
        "duration": 400,
        "post_wait_freezes": 400,
        "timeout": 4000,
        "next": ["PanelDrained2"],
        "on_error": ["TaskPanel", "GiveUp"]
    },

    // 面板是可滚动列表，只扫当前屏就说「做完了」是假阳性：
    // 露出来的可能正好全是邀请好友、小游戏这类不做的行。
    // 所以第一段判定成立后先把列表往下滚一屏，再判一次，两次都没有才算清空。
    "PanelDrained2": {
        "recognition": "OCR",
        "expected": ["浏览\\d+", "点击去逛"],
        "inverse": true,
        "action": "DoNothing",
        "timeout": 4000,
        "next": [],
        "on_error": ["TaskPanel", "GiveUp"]
    },

    // 面板里混着玩小游戏、邀请好友、花积分兑换这类做不了也不该自动点的任务，
    // 它们的按钮同样写着「去完成」。所以认的是副标题「浏览N秒」，再用行内偏移点到
    // 同一行的按钮列：副标题中心相对按钮中心是 (+399, -19)，短边固定 720 所以横向稳定。
    //
    // 不做「换一行」的轮转节点，改成随机选行，理由见下面的 order_by。
    "TaskRow": {
        "recognition": "OCR",
        "expected": ["浏览\\d+[秒s]", "点击去逛"],
        // 面板列表区：从 y=300 往下、左半屏（右半屏是「去完成」按钮列，靠偏移点）。
        // 顶部那条读秒气泡也写着「浏览15秒」，所以 y 起点必须留在它下面。
        "roi": [0, 300, 560, 0],
        // 随机取一条，而不是取最上面那条：做完的行会从列表里消失，但做不了的行
        // （下单返能量那类）不会消失，于是 index 0 永远指向同一行 —— 实测连点 8 次
        // 同一条（副标题框 y 稳定在 854 上下），整轮在那一行上原地打转。
        // 随机选的代价是可能连着抽到做不了的行；这种行现在被 OrderBait 秒退（约 8 秒），
        // 抽几次就轮到能做的行。早先读秒没修对、一次失败要烧 90 秒时才需要严格扫表。
        "order_by": "Random",
        "action": "Click",
        "target_offset": [399, -19, 0, 0],
        "post_wait_freezes": 500,
        "post_delay": 2000,
        // 剩下全是下单返能量、小游戏这类做不了的行时，随机选行会无限空转；
        // 给一个总次数上限，让无人值守的一轮自己收尾，而不是烧满墙钟预算。
        "max_hit": 40,
        "timeout": 20000,
        "next": ["TaskPageEnter"],
        "on_error": ["EarnEnergy", "GiveUp"]
    },

    // 进落地页先只看不滑。TaskPage 一上来就是一记 15 秒全长下滑，而搜索类页面要点的
    // 「搜索发现」标题就在屏幕中上部，一记下滑就把它推出屏幕，节点再也认不到，
    // 于是变成「没点任何东西却一直在滑」。这里给 8 秒先把入口点了，再交给下滑轮次。
    "TaskPageEnter": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "rate_limit": 800,
        "timeout": 8000,
        "next": ["NoInstall", "DangerPage", "CloseCircle", "SearchSuggestion", "SearchDiscover", "OrderBait", "TaskPage"],
        "on_error": ["TaskPage", "GiveUp"]
    },

    // 落地页下滑。这里有个协议层的坑要写清楚：一个节点的 timeout 只管「动作做完之后
    // 反复扫 next 列表等命中」那一段时间，节点自己不会被重复执行。所以「滑 6 秒 +
    // 等 30 秒」不会变成 5 次下滑，而是 1 次下滑加 30 秒干等 —— 抬手期间读秒不走，
    // 于是任务永远做不完。实测：一次 6 秒下滑之后 33 秒画面完全静止。
    //
    // 要连续滑就得把轮次显式串出来：TaskPage 滑 15 秒 → 扫一遍 next（可领/危险页/
    // 面板…）→ 没命中就交给 TaskPage2 再滑 15 秒 → 再扫一遍 → 还没有就超时退出。
    // 15 秒是照着气泡要求的「浏览15秒」给的，一记连续拖拽，不抬手。
    "TaskPage": {
        "recognition": "DirectHit",
        "action": "Swipe",
        "begin": [360, 1400],
        "end": [360, 200],
        "duration": 15000,
        "rate_limit": 300,
        "timeout": 10000,
        "next": ["NeedHuman", "DangerPage", "TaskPanel", "NoInstall", "TaskFinished", "OrderBait", "DismissDialog", "CloseCircle", "SearchSuggestion", "SearchDiscover", "SignIn", "CloseX", "TaskPage2"],
        "on_error": ["CornerBack", "GiveUp"]
    },

    // 第二轮下滑。next 里不再挂自己，也不挂第三轮，所以一条任务的下滑时间被结构本身
    // 限死在 30 秒，不需要 max_hit 参与（max_hit 是整轮共享、不可续的，用它限单页轮次
    // 会让后面正常的任务一起饿死）。
    "TaskPage2": {
        "recognition": "DirectHit",
        "action": "Swipe",
        "begin": [360, 1400],
        "end": [360, 200],
        "duration": 15000,
        "rate_limit": 300,
        "timeout": 10000,
        "next": ["NeedHuman", "DangerPage", "TaskPanel", "NoInstall", "TaskFinished", "OrderBait", "DismissDialog", "CloseCircle", "SearchSuggestion", "SearchDiscover", "SignIn", "CloseX"],
        "on_error": ["CornerBack", "GiveUp"]
    },

    // 读秒走完的完成态是「已得400能量」+ 一个对勾，**平台自动到账，不需要点任何东西**。
    // 实测逐帧：气泡右侧的小方块是剩余秒数（12 → 7 → 1），归零后整条横幅换成
    // 「已得400能量」，再往后变成「⚡400 | 下单再得⚡2000」。
    //
    // 这里踩过两个反向的坑，都记下来免得再犯：
    // 1) 曾经用「可领」当完成信号。未完成的气泡本身就写着「浏览15秒可领+400」，
    //    而且 OCR 有时会把它切成「浏览15秒」+「可领+400」两框，所以认「可领」等于
    //    在读秒刚过半就去点一个不可点的框，点完退出 —— 计数器 1:1，能量一分没进。
    // 2) 因为 1) 提前退出，读秒从来没走完过，于是「已得N」在日志里一次都没出现过，
    //    又被当成死节点删掉。两个错误互相掩盖，只有逐帧看画面才发现。
    "TaskFinished": {
        "recognition": "OCR",
        "expected": ["已得\\d+", "任务已完成"],
        "action": "DoNothing",
        "timeout": 8000,
        "next": ["TaskPanel", "CornerBack"],
        "on_error": ["CornerBack", "GiveUp"]
    },

    // 搜一搜任务落在「搜索有福利」的关键词页，必须先挑一个词才会进结果页开始读秒。
    // 点关键词卡片的副标题；卡片词每天变，副标题格式不变。
    // 提交由 SearchSubmit 负责，那个按钮在顶栏，不在本节点的 roi 里。
    "SearchSuggestion": {
        "recognition": "OCR",
        "expected": ["近一个月", "行业新[趋超]商品", "行业口碑商品"],
        "roi": [0, 300, 0, 0],
        "order_by": "Vertical",
        "index": 0,
        "action": "Click",
        "post_wait_freezes": 500,
        "post_delay": 1500,
        "timeout": 5000,
        "next": ["SearchSubmit"],
        "on_error": ["TaskPage", "GiveUp"]
    },

    // 要求输入关键词的搜索页不用打字：「搜索发现」下面就是平台给的推荐词，
    // 认到标题后按行偏移点第一条。不点「历史搜索」那排，那是账号自己的记录。
    // 标题框中心 (84, 450)，第一张卡片中心约 (200, 520)。
    "SearchDiscover": {
        "recognition": "OCR",
        "expected": ["搜索发现"],
        "action": "Click",
        "target_offset": [116, 70, 0, 0],
        "post_wait_freezes": 500,
        "post_delay": 2500,
        "timeout": 5000,
        "next": ["SearchSubmit"],
        "on_error": ["TaskPage", "GiveUp"]
    },

    // 点推荐词只是把词填进输入框，画面几乎不变；必须再按顶栏的「搜索」才会真的出结果、
    // 才开始读秒。按钮在搜索栏右侧，roi 收到顶部一条，避开正文里的「搜索」字样。
    // 只能由 SearchSuggestion / SearchDiscover 串过来，绝不能放进 TaskPage 的轮询链：
    // 结果页顶栏同样有「搜索」，反复提交会把列表滚回顶部，读秒永远攒不满。
    "SearchSubmit": {
        "recognition": "OCR",
        // 不锚定：OCR 偶尔把按钮读成「搜索 」或带半个字符，^搜索$ 会整帧错过。
        // roi 已经锁死右上角那一条，左边输入框里的「搜索宝贝」占位符进不来。
        "expected": ["搜索"],
        "roi": [430, 90, 290, 210],
        "action": "Click",
        "post_wait_freezes": 500,
        "post_delay": 2000,
        "timeout": 12000,
        "next": ["TaskPage"],
        "on_error": ["TaskPage", "GiveUp"]
    },

    // 有些行点进去是「下单返能量」：页面本身没有浏览读秒，唯一能拿能量的动作是花钱下单。
    // 认顶部横幅的「下单再得」开头。锚定是必须的：任务做完的横幅是完整一框
    // 「已得400丨下单再得2000」，它以「已得」开头，归 TaskFinished 管，不能被这里抢走。
    //
    // 放进 TaskPageEnter（进页面先只看不滑那 8 秒）等于一进这种页就走，
    // 不再白滑两轮 30 秒 —— 实测今天后面剩的行大半是这类，一段里 14 次点入只成了 3 次。
    "OrderBait": {
        "recognition": "OCR",
        // 「未找到相关内容」是搜索类任务会撞上的空结果页：整页没有商品，也就没有
        // 可读的秒，继续滑只是白滑两轮 30 秒。和下单横幅归成一类：这页没事情可做。
        "expected": ["^下单再得", "^下单得\\d+", "^未找到"],
        "action": "DoNothing",
        "max_hit": 30,
        "timeout": 4000,
        "next": ["CornerBack"],
        "on_error": ["CornerBack", "GiveUp"]
    },

    // 部分落地页要先在页面里点一下签到/领取，气泡才会开始读秒。
    "SignIn": {
        "recognition": "OCR",
        "expected": ["立即签到", "马上签到", "签到领取"],
        "action": "Click",
        "post_wait_freezes": 400,
        "max_hit": 10,
        "timeout": 3000,
        "next": ["TaskPage"],
        "on_error": ["TaskPage", "GiveUp"]
    },

    // 相机、通知这类系统授权框会盖住一切，先按「不授权」方向关掉再继续。
    // 「取消」也归这里：跳出淘宝去外部链接时（如今日头条的文章页）会弹一整幅
    // 「提示 / 下个页面不受我们控制哦」的模态框，遮罩把左上角返回和边缘手势全吃掉，
    // 唯一出路是按「取消」留在原页面 —— 实测整轮卡在这里空转，两个退出动作各 10 次。
    // 只认整框「^取消$」，且 DangerPage 在每条候选链里都排在它前面，所以订单页上的
    // 「取消」不会被点到；搜索框那种取消按钮点下去也只是收起键盘，无害。
    "DismissDialog": {
        "recognition": "OCR",
        "expected": ["不允许", "暂不", "以后再说", "稍后再说", "^取消$"],
        "action": "Click",
        "post_wait_freezes": 400,
        "timeout": 3000,
        "next": ["TaskPanel"],
        "on_error": ["EarnEnergy", "GiveUp"]
    },

    // 有些落地页没有左上角返回，关闭 X 在右上角。X 是页面自绘的叉，
    // OCR 会读成 X 或 ×，锁在右上角一条里避免认到正文。
    "CloseX": {
        "recognition": "OCR",
        "expected": ["^[X×]$"],
        "roi": [500, 40, 220, 380],
        "action": "Click",
        "post_wait_freezes": 500,
        "max_hit": 12,
        "timeout": 4000,
        "next": ["TaskPanel"],
        "on_error": ["EarnEnergy", "GiveUp"]
    },

    // 弹窗的关闭键常常是画面正中一个圆圈 X 图标（芭芭农场那种「玩游戏得现金」），
    // 不是文字，CloseX 的 OCR 认不到。用模板在全屏找它，认中就点掉。
    "CloseCircle": {
        "recognition": "TemplateMatch",
        "template": "CloseCircle",
        "threshold": 0.65,
        "action": "Click",
        "post_wait_freezes": 400,
        "max_hit": 20,
        "timeout": 6000,
        "next": ["TaskPage"],
        "on_error": ["TaskPage", "GiveUp"]
    },

    // 离开别人的活动页（淘宝成就的打卡）会弹「真的要离开吗 / 狠心离开 / 继续做任务」。
    // 一律选离开：留在别人的签到链路里对我们没有任何意义，还会把整轮时间吃掉。
    "LeaveDialog": {
        "recognition": "OCR",
        "expected": ["狠心离开", "忍痛离开", "仍要离开", "残忍离开", "直接离开"],
        "action": "Click",
        "post_wait_freezes": 500,
        "max_hit": 10,
        "timeout": 4000,
        "next": ["EarnEnergy"],
        "on_error": ["EarnEnergy", "GiveUp"]
    },

    // 小游戏之类会整页跳到支付宝，iOS 在屏幕最左上角给了「◀ 淘宝」跨应用返回。
    // 这个只能认文字：尖角旁边的来源 app 名就是「淘宝」，roi 锁在左上角一条。
    "BackToTaobao": {
        "recognition": "OCR",
        // 必须锚定整框：「淘宝成就」「淘宝人生」这类页面标题也在左上角同一条里，
        // 不锚定就会一直去点标题，跨应用返回永远等不到。
        "expected": ["^淘宝$"],
        "roi": [0, 40, 220, 100],
        "action": "Click",
        "post_wait_freezes": 500,
        "max_hit": 10,
        "timeout": 6000,
        "next": ["EarnEnergy"],
        "on_error": ["EarnEnergy", "GiveUp"]
    },

    // 滑块、图形验证码是平台在明确拒绝自动化，硬闯既没用也可能伤账号。
    // 认出来就直接收工退出，把剩下的交给人。
    // 必须带「验证」二字：搜索历史里就有「mgn7滑块」这种关键词卡片，
    // 只认「滑块」会把正常页面误判成验证码，整轮直接白退。
    "NeedHuman": {
        "recognition": "OCR",
        "expected": ["滑块验证", "拖动滑块", "安全验证", "请输入验证码"],
        "action": "DoNothing",
        "next": []
    },

    // 引导装 App 的页面直接跳过，页面上任何东西都不点（「立即领取」常常就是下载按钮的皮）。
    // 判定只用「极速版 / 下载App / 安装后」这类只有拉新页才会出现的词：不用光秃秃的
    // 「下载」，也不用「快手」「抖音」这种宿主 App 名 —— 面板里就有一行任务叫
    // 「去快手打卡领手机」，而 NoInstall 排得比 TaskPanel 靠前，结果每次回到面板都被它
    // 抢走、把面板当拉新页退掉。所以既收窄关键词，也把它挪到 TaskPanel 之后。
    "NoInstall": {
        "recognition": "OCR",
        "expected": ["极速版", "下载App", "下载APP", "安装后", "打开App", "打开APP"],
        "action": "DoNothing",
        "max_hit": 20,
        "timeout": 4000,
        "next": ["CornerBack"],
        "on_error": ["CornerBack", "GiveUp"]
    },

    // 订单、支付这类页面绝对不能点页面上的任何东西：浏览任务会逛到商品页，
    // 兜底的盲点和「领取」类文案一旦落到交易链路上就是真金白银。
    // 认出这些字样就只做退出，别的节点全部让路。
    // 每个词都要锚定整框（^...$）：商品页上有「确认收货后自动发放」这类文案，
    // 不锚定就把正常浏览页全部误杀，实测会一条任务都做不完。也不写「购物车」。
    "DangerPage": {
        "recognition": "OCR",
        // 只留页面级的交易文案。「下单再得 / 下单得N」原来也在这里，但它其实是
        // 浏览任务成功后横幅的下半句（「⚡400 | 下单再得⚡2000」），商品卡上也满是
        // 「下单得1744淘金币」—— 放在全屏识别里等于把「任务刚做完」判成危险页逃走。
        "expected": ["^确认收货$", "^实付款", "^提交订单$", "^立即支付$", "^去支付$", "待确认收货", "^订单信息$", "^订单编号"],
        "action": "DoNothing",
        "max_hit": 30,
        "timeout": 4000,
        "next": ["CornerBack", "EdgeBack"],
        "on_error": ["EarnEnergy", "GiveUp"]
    },

    // 需要用户自己决定的弹窗（选涂装、选队伍、选礼物），既挡住了整条识别链，
    // 也不该由自动化代劳 —— 这类选择往往不可撤销，或者关闭就等于随机选。
    // 认出来就带原因退出，别再往下降级去重开应用。
    "Blocked": {
        "recognition": "OCR",
        "expected": ["确认选择", "不可修改", "将随机为", "请选择"],
        "action": "DoNothing",
        "timeout": 4000,
        "next": ["GiveUp"],
        "on_error": ["GiveUp"]
    },

    // 落到淘宝根 tab（关注/推荐/店铺信息流）时，iOS 侧没有 deeplink，但有一条纯 UI 的
    // 回家路：底部「我的淘宝」→ 权益行里的「淘金币」→ 就是双11活动页。
    // roi 锁在底部右侧那一格 tab（贴住下边缘，不认到正文里的「我的淘宝」）。
    "GoMine": {
        "recognition": "OCR",
        "expected": ["我的淘宝"],
        "roi": [560, -90, 160, 90],
        "action": "Click",
        "post_wait_freezes": 600,
        "post_delay": 1500,
        "max_hit": 8,
        "timeout": 6000,
        "next": ["GoldEntry"],
        "on_error": ["EarnEnergy", "GiveUp"]
    },

    // 权益行「红包 / 优惠券 / 淘金币抵 / 天猫积分」里的淘金币入口。
    // 排在 OpenTaskPanel 之后，活动页能直接认出「去赚能量」时轮不到它。
    "GoldEntry": {
        "recognition": "OCR",
        "expected": ["淘金币抵", "淘金币"],
        "roi": [0, 850, 0, 400],
        "action": "Click",
        "post_wait_freezes": 800,
        "post_delay": 2000,
        "max_hit": 8,
        "timeout": 8000,
        "next": ["EarnEnergy"],
        "on_error": ["EarnEnergy", "GiveUp"]
    },

    // 退出梯子的最后一级。bundle id 是从设备上 app.list 读出来的，不是猜的；
    // iOS 的 start_app 收的就是 bundle id，且不杀已运行实例 —— 所以只有
    // 「已经不在淘宝里」或「淘宝已经退到后台」时它才有用，页面卡住时它是空转。
    "LaunchTaobao": {
        "recognition": "DirectHit",
        "action": "StartApp",
        "package": "com.taobao.taobao4iphone",
        "post_wait_freezes": { "time": 1500, "timeout": 4000, "target": [0, 0, 720, 1559] },
        // 冷启动淘宝要 5~8 秒才出画面，等太短会在白屏上判失败、把次数白白烧完。
        "post_delay": 6000,
        "max_hit": 3,
        "timeout": 6000,
        "next": ["EarnEnergy"],
        "on_error": ["EarnEnergy", "GiveUp"]
    },

    // 两个手势退出动作互为重试路径：单次失败不该把整轮长跑判死。
    // 实测要点：必须是密集的慢速拖拽（几十个点、约 500ms），两三个点的快速划不会触发手势。
    // 而且并非所有页面都响应边缘手势（淘宝首页信息流、部分 H5 完全不理），
    // 所以它排在盲点返回箭头后面，只作为第二选择。
    "EdgeBack": {
        "recognition": "DirectHit",
        "action": "Swipe",
        "begin": [2, 780],
        "end": [330, 780],
        "duration": 500,
        "post_wait_freezes": { "time": 500, "timeout": 2000, "target": [0, 0, 720, 1559] },
        "post_delay": 1000,
        "max_hit": 40,
        "timeout": 6000,
        "next": ["EarnEnergy"],
        "on_error": ["EarnEnergy", "GiveUp"]
    },

    // 退出梯子的第一级：盲点左上角的返回箭头。
    // 箭头位置实测在 (42, 162) 附近（H5 自绘的偏下，小程序导航栏的偏上），
    // 所以框取 x 20..75 / y 120..195：MaaFW 在框内随机取点且中心权重高。
    // 之前框取的是 y 108..163，落点全在箭头上方十几像素，点了个空。
    "CornerBack": {
        "recognition": "DirectHit",
        "action": "Click",
        "target": [20, 100, 55, 90],
        "post_wait_freezes": { "time": 500, "timeout": 2000, "target": [0, 0, 720, 1559] },
        "post_delay": 1000,
        // 它同时是「任务做完后回面板」的正常出口，所以一条任务就要花掉一次额度。
        // 实测 21 分钟点了 24 行、用了 25 次，额度用尽后 TaskFinished 的 next 全空，
        // 直接 "invalid node id" 掉进 GiveUp。上限按 TaskRow 额度的三倍给。
        "max_hit": 120,
        "timeout": 6000,
        "next": ["EdgeBack"],
        "on_error": ["EdgeBack", "GiveUp"]
    },

    "GiveUp": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": []
    }
}
